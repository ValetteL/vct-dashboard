		summarizeBy: none
		sourceColumn: MapsJouees

	column WinAttaque
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: f081e17c-771a-4d28-bc93-eab70bb6fac1
		summarizeBy: none
		sourceColumn: WinAttaque

	column WinDefense
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: 008e30c2-4ec2-47c4-abc6-cf432dc91d91
		summarizeBy: none
		sourceColumn: WinDefense

	partition Contextes = m
		mode: import
		source =
				let
					Charger = (a as number) =>
						let
							Source = Csv.Document(File.Contents(Dossier_Data & "maps_stats_" & Number.ToText(a) & ".csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
							Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
							AvecAnnee = Table.AddColumn(Entetes, "Annee", each a, Int64.Type)
						in
							AvecAnnee,
					Tout = Table.Combine(List.Transform({2021 .. 2026}, Charger)),
					SansAgregats = Table.SelectRows(Tout, each [Map] <> "All Maps" and [Stage] <> "All Stages" and [#"Match Type"] <> "All Match Types"),
					Renomme = Table.RenameColumns(SansAgregats, {{"Tournament", "Tournoi"}, {"Match Type", "MatchType"}, {"Total Maps Played", "MapsJouees"}, {"Attacker Side Win Percentage", "WinAttaque"}, {"Defender Side Win Percentage", "WinDefense"}}),
					Pourcentages = Table.TransformColumns(Renomme, {{"WinAttaque", each Number.FromText(Text.Replace(_, "%", ""), "en-US") / 100, type number}, {"WinDefense", each Number.FromText(Text.Replace(_, "%", ""), "en-US") / 100, type number}}),
					Types = Table.TransformColumnTypes(Pourcentages, {{"Tournoi", type text}, {"Stage", type text}, {"MatchType", type text}, {"Map", type text}, {"MapsJouees", Int64.Type}}, "en-US"),
					Cle = Table.AddColumn(Types, "Cle", each Text.From([Annee]) & "|" & [Tournoi] & "|" & [Stage] & "|" & [MatchType] & "|" & [Map], type text),
					Final = Table.SelectColumns(Cle, {"Cle", "Annee", "Tournoi", "Stage", "MatchType", "Map", "MapsJouees", "WinAttaque", "WinDefense"})
				in
					Final

	annotation PBI_ResultType = Table

