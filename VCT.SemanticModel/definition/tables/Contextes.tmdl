table Contextes
	lineageTag: eaf36525-e5c7-4001-8e21-39dbf72e822b

	column Cle
		dataType: string
		isHidden
		lineageTag: 401448c5-82e8-4dcd-b2a7-ac124dfa4558
		summarizeBy: none
		sourceColumn: Cle

	column Annee
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b620e66d-14f3-4d40-a5d2-7e5f44e788d6
		summarizeBy: none
		sourceColumn: Annee

	column Tournoi
		dataType: string
		lineageTag: ac04690c-962d-4437-b9a2-50dc9039021e
		summarizeBy: none
		sourceColumn: Tournoi

	column Stage
		dataType: string
		lineageTag: 0e7fdf0c-826e-4ad6-a255-14e5b010f32c
		summarizeBy: none
		sourceColumn: Stage

	column MatchType
		dataType: string
		lineageTag: 9b3e36f1-cf0d-4322-a2e3-2ce4bbc41637
		summarizeBy: none
