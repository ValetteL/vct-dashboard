model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Annees","Cartes","Agents","Contextes","Picks","Draft","_Mesures","_Mesures_Overview","_Mesures_Evolution","_Mesures_Maps","_Mesures_Performance","Dossier_Data"]

annotation PBI_ProTooling = ["DevMode"]

ref table Annees
ref table Cartes
ref table Agents
ref table Contextes
ref table Picks
ref table Draft
ref table _Mesures
ref table _Mesures_Overview
ref table _Mesures_Evolution
ref table _Mesures_Maps
ref table _Mesures_Performance

